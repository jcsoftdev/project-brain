---
import { SECTIONS } from "../data/sections";

const year = 2026;
---

<footer>
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <a class="brand" href="/">
          <svg class="brand-mark" width="22" height="22" aria-hidden="true"><use href="#mark"/></svg>
          <span>project-brain</span>
        </a>
        <p class="dim">
          Local-first MCP server that gives AI tools semantic and structural memory of your codebase.
        </p>
      </div>

      <div class="foot-cols">
        <div>
          <h3>Sections</h3>
          {SECTIONS.map((s) => <a href={s.href}>{s.label}</a>)}
        </div>
        <div>
          <h3>Project</h3>
          <a href="https://github.com/jcsoftdev/project-brain" rel="noopener">GitHub</a>
          <a href="https://www.npmjs.com/package/project-brain" rel="noopener">npm</a>
          <a href="https://github.com/jcsoftdev/homebrew-tap" rel="noopener">Homebrew tap</a>
          <a href="https://github.com/jcsoftdev/project-brain/releases" rel="noopener">Releases</a>
        </div>
        <div>
          <h3>See also</h3>
          <a href="https://modelcontextprotocol.io" rel="noopener">Model Context Protocol</a>
          <a href="https://ollama.com" rel="noopener">Ollama</a>
          <a href="https://lancedb.com" rel="noopener">LanceDB</a>
          <a href="https://github.com/GoogleCloudPlatform/knowledge-catalog/blob/main/okf/SPEC.md" rel="noopener">OKF spec</a>
        </div>
      </div>
    </div>

    <div class="foot-base">
      <span>MIT &middot; &copy; {year} <a href="https://github.com/jcsoftdev" rel="noopener">jcsoftdev</a></span>
      <span class="quiet">Nothing on this page phones home.</span>
    </div>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--rule); padding-block: 46px 30px; }
  .foot-top { display: grid; gap: 34px; margin-bottom: 34px; }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 36px;
    color: var(--fg);
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 10px;
  }
  .brand:hover { text-decoration: none; }
  .brand-mark { color: var(--terra); --node: var(--sea); flex-shrink: 0; }
  .foot-brand p { font-size: 14px; max-width: 42ch; }

  .foot-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px 20px; }
  .foot-cols h3 {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--terra);
    font-weight: 500;
    margin: 0 0 10px;
  }
  .foot-cols a {
    display: flex;
    align-items: center;
    min-height: 36px;
    font-size: 14px;
    color: var(--fg-2);
  }
  .foot-cols a:hover { color: var(--terra); text-decoration: none; }

  .foot-base {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    justify-content: space-between;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    font-size: 13px;
    color: var(--fg-3);
  }
  .foot-base a { color: var(--fg-2); }

  @media (min-width: 600px) {
    footer { padding-block: 60px 34px; }
    .foot-cols { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  }

  @media (min-width: 900px) {
    .foot-top { grid-template-columns: minmax(0, 1fr) minmax(0, 1.9fr); gap: 52px; }
  }
</style>
