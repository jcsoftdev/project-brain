---
const year = 2026;
---

<footer>
  <div class="wrap foot">
    <div class="foot-brand">
      <strong class="mono">project-brain</strong>
      <p class="dim">
        Local-first MCP server that gives AI tools semantic memory of your codebase.
        MIT licensed &middot; &copy; {year} <a href="https://github.com/jcsoftdev" rel="noopener">jcsoftdev</a>
      </p>
    </div>

    <div class="foot-cols">
      <div>
        <h4>Project</h4>
        <a href="https://github.com/jcsoftdev/project-brain" rel="noopener">GitHub</a>
        <a href="https://www.npmjs.com/package/project-brain" rel="noopener">npm</a>
        <a href="https://github.com/jcsoftdev/homebrew-tap" rel="noopener">Homebrew tap</a>
        <a href="https://github.com/jcsoftdev/project-brain/releases" rel="noopener">Releases</a>
      </div>
      <div>
        <h4>Docs</h4>
        <a href="#start">Quick start</a>
        <a href="#tools">MCP tools</a>
        <a href="#recipes">Recipes</a>
        <a href="#install">Install channels</a>
      </div>
      <div>
        <h4>Related</h4>
        <a href="https://modelcontextprotocol.io" rel="noopener">Model Context Protocol</a>
        <a href="https://ollama.com" rel="noopener">Ollama</a>
        <a href="https://lancedb.com" rel="noopener">LanceDB</a>
        <a href="https://github.com/GoogleCloudPlatform/knowledge-catalog/blob/main/okf/SPEC.md" rel="noopener">OKF spec</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--border-soft); padding: 56px 0 64px; }
  .foot {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 2fr);
    gap: 48px;
  }
  .foot-brand strong { display: block; font-size: 15px; margin-bottom: 10px; }
  .foot-brand p { font-size: 14px; max-width: 320px; }
  .foot-cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .foot-cols h4 {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
    font-weight: 500;
    margin: 0 0 14px;
  }
  .foot-cols a {
    display: block;
    font-size: 14px;
    color: var(--fg-muted);
    margin-bottom: 9px;
  }
  .foot-cols a:hover { color: var(--fg); text-decoration: none; }
  @media (max-width: 760px) {
    .foot { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .foot-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
