---
const year = 2026;
---

<footer>
  <div class="wrap foot">
    <div class="foot-brand">
      <strong class="mono">project-brain</strong>
      <p class="dim">
        Local-first MCP server that gives AI tools semantic memory of your codebase.
        MIT licensed &middot; &copy; {year} <a href="https://github.com/jcsoftdev" rel="noopener">jcsoftdev</a>
      </p>
    </div>

    <div class="foot-cols">
      <div>
        <h3>Project</h3>
        <a href="https://github.com/jcsoftdev/project-brain" rel="noopener">GitHub</a>
        <a href="https://www.npmjs.com/package/project-brain" rel="noopener">npm</a>
        <a href="https://github.com/jcsoftdev/homebrew-tap" rel="noopener">Homebrew tap</a>
        <a href="https://github.com/jcsoftdev/project-brain/releases" rel="noopener">Releases</a>
      </div>
      <div>
        <h3>Docs</h3>
        <a href="#start">Quick start</a>
        <a href="#tools">MCP tools</a>
        <a href="#recipes">Recipes</a>
        <a href="#install">Install channels</a>
      </div>
      <div>
        <h3>Related</h3>
        <a href="https://modelcontextprotocol.io" rel="noopener">Model Context Protocol</a>
        <a href="https://ollama.com" rel="noopener">Ollama</a>
        <a href="https://lancedb.com" rel="noopener">LanceDB</a>
        <a href="https://github.com/GoogleCloudPlatform/knowledge-catalog/blob/main/okf/SPEC.md" rel="noopener">OKF spec</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--border-soft); padding-block: 44px 52px; }

  /* Single column on a phone; the link columns pair up from sm and split at md. */
  .foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 34px;
  }

  .foot-brand strong { display: block; font-size: 15px; margin-bottom: 9px; }
  .foot-brand p { font-size: 14px; max-width: 340px; }

  .foot-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px 20px;
  }
  .foot-cols h3 {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
    font-weight: 500;
    margin: 0 0 10px;
  }
  /* Footer links are the densest tap targets on the page — give them height. */
  .foot-cols a {
    display: flex;
    align-items: center;
    min-height: 34px;
    font-size: 14px;
    color: var(--fg-muted);
  }
  .foot-cols a:hover { color: var(--fg); text-decoration: none; }

  @media (min-width: 600px) {
    footer { padding-block: 52px 60px; }
    .foot { gap: 40px; }
    .foot-cols { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  }

  @media (min-width: 880px) {
    footer { padding-block: 56px 64px; }
    .foot { grid-template-columns: minmax(0, 1.3fr) minmax(0, 2fr); gap: 48px; }
    .foot-cols h3 { font-size: 11.5px; margin-bottom: 14px; }
    .foot-cols a { min-height: 0; margin-bottom: 9px; }
  }
</style>
