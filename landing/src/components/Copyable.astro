---
interface Props {
  command: string;
  label?: string;
}
const { command, label } = Astro.props;
---

<div class="copyable" data-command={command}>
  {label && <span class="copyable-label">{label}</span>}
  <code><span class="prompt" aria-hidden="true">$</span>{command}</code>
  <button type="button" class="copy-btn" aria-label={`Copy command: ${command}`}>
    <span class="copy-text">copy</span>
  </button>
</div>

<style>
  /*
   * Phone: the command wraps and the button takes its own full-width row. A
   * 40-character install command cannot share a 320px line with a control, and
   * scrolling a one-line box hides the half that matters.
   */
  .copyable {
    display: grid;
    gap: 11px;
    background: var(--inset);
    border: 1px solid var(--rule);
    border-radius: var(--r-sm);
    padding: 13px 15px;
  }
  .copyable-label {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  code {
    display: block;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--fg);
    background: none;
    padding: 0;
    overflow-wrap: anywhere;
  }
  .prompt { color: var(--sea); margin-right: 10px; user-select: none; }

  .copy-btn {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 8px 15px;
    background: transparent;
    border: 1px solid var(--rule-2);
    border-radius: 999px;
    color: var(--fg-2);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: color .15s, border-color .15s;
  }
  .copy-btn:hover, .copy-btn.copied { color: var(--terra); border-color: var(--terra); }

  @media (min-width: 600px) {
    .copyable {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 14px;
      padding: 10px 10px 10px 15px;
    }
    .copyable-label { white-space: nowrap; }
    .copyable > code:first-child { grid-column: 1 / 3; }
    code { font-size: 13.5px; overflow-wrap: normal; }
    .copy-btn { min-height: 36px; padding: 6px 14px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".copyable").forEach((el) => {
    const btn = el.querySelector<HTMLButtonElement>(".copy-btn");
    const text = el.querySelector<HTMLElement>(".copy-text");
    const command = el.dataset.command ?? "";
    if (!btn || !text) return;

    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(command);
      } catch {
        return;
      }
      btn.classList.add("copied");
      text.textContent = "copied";
      window.setTimeout(() => {
        btn.classList.remove("copied");
        text.textContent = "copy";
      }, 1600);
    });
  });
</script>
