---
interface Props {
  command: string;
  label?: string;
}
const { command, label } = Astro.props;
---

<div class="copyable" data-command={command}>
  {label && <span class="copyable-label">{label}</span>}
  <code><span class="prompt" aria-hidden="true">$</span>{command}</code>
  <button type="button" class="copy-btn" aria-label={`Copy command: ${command}`}>
    <span class="copy-text">copy</span>
  </button>
</div>

<style>
  /*
   * A command line, not a component. Square, flush, prompt on the left, and
   * the copy affordance is a bracketed word rather than an icon — an icon
   * would be the only pictogram in a page made of characters.
   */
  .copyable {
    display: grid;
    gap: 10px;
    border: 1px solid var(--rule);
    border-left: 2px solid var(--accent-quiet);
    background: var(--bg-soft);
    padding: 12px 14px;
  }

  .copyable-label {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  code {
    display: block;
    font-size: 13px;
    line-height: 1.6;
    color: var(--fg);
    background: none;
    padding: 0;
    overflow-wrap: anywhere;
  }
  .prompt { color: var(--accent); margin-right: 10px; user-select: none; }

  .copy-btn {
    justify-self: start;
    min-height: var(--tap);
    padding: 6px 10px;
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 0;
    color: var(--fg-dim);
    font-family: var(--mono);
    font-size: 12px;
    cursor: pointer;
  }
  .copy-btn::before { content: "["; margin-right: 6px; }
  .copy-btn::after { content: "]"; margin-left: 6px; }
  .copy-btn:hover { color: var(--accent); border-color: var(--accent-dim); }
  .copy-btn.copied { color: var(--accent); border-color: var(--accent-dim); }

  @media (min-width: 600px) {
    .copyable {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 14px;
      padding: 10px 10px 10px 14px;
    }
    .copyable-label { white-space: nowrap; }
    .copyable > code:first-child { grid-column: 1 / 3; }
    code { font-size: 13.5px; overflow-wrap: normal; }
    .copy-btn { min-height: 34px; padding: 5px 10px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".copyable").forEach((el) => {
    const btn = el.querySelector<HTMLButtonElement>(".copy-btn");
    const text = el.querySelector<HTMLElement>(".copy-text");
    const command = el.dataset.command ?? "";
    if (!btn || !text) return;

    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(command);
      } catch {
        return;
      }
      btn.classList.add("copied");
      text.textContent = "copied";
      window.setTimeout(() => {
        btn.classList.remove("copied");
        text.textContent = "copy";
      }, 1600);
    });
  });
</script>
