---
/*
 * A table on a phone is the wrong shape: 3 columns of prose in 375px either
 * truncate or force a horizontal swipe the reader has no reason to guess at.
 *
 * So below `sm` each row renders as a stacked block with its column name as a
 * label, and from `sm` up the same markup lays out as a real table. One source
 * of markup, two layouts — nothing is duplicated or hidden from a screen reader.
 *
 * `code` marks which columns hold identifiers rather than prose.
 */
interface Props {
  columns: string[];
  rows: string[][];
  code?: number[];
  italic?: number[];
}

const { columns, rows, code = [], italic = [] } = Astro.props;

/*
 * On a two-column table the second cell is plainly the description of the
 * first, so stamping "WHAT IT DOES" above all six rows is noise. From three
 * columns up the labels are what tell CLI apart from Platforms, so they stay.
 */
const showLabels = columns.length > 2;
---

<div class:list={["dt", showLabels && "dt-labelled"]}>
  <table>
    <thead>
      <tr>{columns.map((c) => <th scope="col">{c}</th>)}</tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.map((cell, i) => (
            <td
              data-label={columns[i]}
              class:list={[code.includes(i) ? "is-code" : "is-prose", italic.includes(i) && "is-quote"]}
            >
              {code.includes(i) ? <code>{cell}</code> : cell}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .dt {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  /* ── phone: stacked blocks ─────────────────────────────────── */
  table { display: block; width: 100%; min-width: 0; border-collapse: collapse; }
  thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  tbody { display: block; }

  tr {
    display: grid;
    gap: 8px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--border-soft);
  }
  tbody tr:last-child { border-bottom: none; }

  td {
    display: block;
    padding: 0;
    border: none;
    white-space: normal;
    font-size: 14px;
    color: var(--fg-muted);
    overflow-wrap: break-word;
  }

  /*
   * Each cell carries its column name on a phone, where the header row is gone.
   * The first cell is the row's subject, so its label would just be noise.
   */
  .dt-labelled td + td::before {
    content: attr(data-label);
    display: block;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
    margin-bottom: 3px;
  }

  td.is-prose:first-child { color: var(--fg); font-weight: 500; }
  td.is-quote { color: var(--fg); font-style: italic; font-weight: 400; }

  td code {
    display: inline-block;
    background: #161d27;
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 2px 7px;
    font-size: 12.5px;
    color: var(--accent);
    overflow-wrap: break-word;
  }

  /* ── sm+: a real table again ───────────────────────────────── */
  @media (min-width: 600px) {
    .dt { overflow-x: auto; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; }

    table { display: table; min-width: 540px; }
    thead {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      display: table-header-group;
    }
    tbody { display: table-row-group; }
    tr { display: table-row; padding: 0; border-bottom: none; }

    th {
      display: table-cell;
      text-align: left;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-soft);
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--fg-dim);
      font-weight: 500;
      white-space: nowrap;
    }

    td {
      display: table-cell;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-soft);
      vertical-align: top;
      font-size: 14.5px;
    }
    tbody tr:last-child td { border-bottom: none; }
    td.is-code { white-space: nowrap; }
    .dt-labelled td + td::before { content: none; }
    td code { font-size: 13px; }
  }
</style>
