---
/*
 * A terminal window carrying a real session.
 *
 * The reason this exists rather than another prose block: every friki site
 * worth copying (ghostty, charm, zed) SHOWS the product running. `impact` is
 * also the one thing on this page grep genuinely cannot do, so showing its
 * output is the strongest single argument available.
 *
 * The session passed in is captured verbatim from a real run — see the comment
 * above `SESSION` in Hero.astro for how to reproduce it.
 *
 * There is deliberately no line-number gutter. It was borrowed from an editor
 * aesthetic, and a shell does not number its output — keeping it while the
 * window shows a real shell session would have been decoration contradicting
 * the thing it frames. It also failed contrast at 2.04:1, which is what
 * prompted the question.
 */
interface Line {
  t: "cmd" | "gap" | "out";
  c?: string;
}
interface Props {
  title?: string;
  lines: Line[];
}
const { title = "zsh — project-brain", lines } = Astro.props;
---

<div class="term">
  <div class="term-bar">
    <span class="tl r"></span><span class="tl y"></span><span class="tl g"></span>
    <span class="term-title">{title}</span>
  </div>
  <div class="term-body">
    {lines.map((l) => (
      <div class="row">
        {l.t === "gap" ? <span class="ln">&nbsp;</span> :
         l.t === "cmd" ? <span class="ln"><b class="pr">$</b> <b class="cm">{l.c}</b></span> :
         <span class="ln out">{l.c}</span>}
      </div>
    ))}
  </div>
</div>

<style>
  .term {
    border: 1px solid var(--rule);
    border-radius: var(--r);
    overflow: hidden;
    background: var(--term-bg);
    box-shadow: 0 30px 64px -28px rgba(0, 0, 0, 0.8);
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 15px;
    background: var(--term-bar);
    border-bottom: 1px solid var(--rule);
  }
  .tl { width: 11px; height: 11px; border-radius: 50%; }
  .tl.r { background: #e0655f; }
  .tl.y { background: var(--ochre); }
  .tl.g { background: var(--sea); }
  .term-title { margin-left: 10px; font-family: var(--mono); font-size: 11.5px; color: var(--fg-3); }

  .term-body {
    padding: 15px 17px 24px;
    overflow-x: hidden;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.85;
  }
  .row { display: block; }
  /*
   * pre-WRAP, not pre. At 375px the captured output is 78 characters — about
   * 560px of mono — so `pre` pushed it into a horizontal scroll and hid half
   * the evidence on a phone. A real terminal wraps long lines rather than
   * hiding them, so wrapping is both the honest rendering and the faithful
   * one. Desktop has the room and never wraps.
   */
  .ln { white-space: pre-wrap; overflow-wrap: anywhere; min-width: 0; }
  .pr { color: var(--sea); }
  .cm { color: var(--fg); font-weight: 500; }
  /* The CLI emits no ANSI colour through a pipe, so output stays one tone.
     Only the prompt and the typed command are highlighted — which is what a
     shell itself does, not something invented for the page. */
  .out { color: var(--fg-2); }

  @media (min-width: 600px) {
    .term-body { font-size: 12.5px; }
  }
</style>
