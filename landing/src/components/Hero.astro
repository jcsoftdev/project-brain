---
import Copyable from "./Copyable.astro";
---

<div class="hero">
  <div class="wrap hero-inner">
    <!--
      A man page header. It is the oldest convention in this medium for saying
      what a program is, and it fits a tool whose whole surface is a CLI and an
      MCP server. It also gives the page a factual opening instead of a claim.
    -->
    <div class="manline">
      <span>project-brain(1)</span>
      <span class="manline-mid quiet">General Commands Manual</span>
      <!-- Deliberately not a version number: nothing here reads package.json,
           so a hardcoded one starts lying at the next release. -->
      <span>Local-first</span>
    </div>

    <p class="head">NAME</p>
    <p class="name-line">
      <b>project-brain</b> <span class="quiet">&mdash;</span> semantic and structural memory of your codebase
    </p>

    <h1>Your AI assistant stops guessing about your codebase.</h1>

    <p class="head">DESCRIPTION</p>
    <p class="desc">
      Two indexes, both on your machine. A <b>LanceDB</b> vector store that finds code by
      meaning, and a <b>tree-sitter</b> symbol graph that answers exactly who calls what and
      what breaks if you change it. Your assistant reaches for whichever one the
      question needs.
    </p>

    <p class="head">SYNOPSIS</p>
    <div class="cta">
      <Copyable command="brew install jcsoftdev/tap/project-brain" />
      <div class="cta-links">
        <a class="btn btn-primary" href="#start">Quick start</a>
        <a class="btn" href="https://github.com/jcsoftdev/project-brain" rel="noopener">Source</a>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-inner { padding-block: 40px 52px; }

  /* The header/footer line of a man page: name left, section centre, version right. */
  .manline {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-dim);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 34px;
  }
  .manline-mid { display: none; }

  /*
   * Labels in the man-page conceit, not document structure — making them
   * headings put an h2 above the h1 and broke the outline.
   */
  .head {
    font-size: 11.5px;
    letter-spacing: 0.22em;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 10px;
  }

  .name-line { color: var(--fg-muted); font-size: 14px; margin-bottom: 34px; }
  .name-line b { color: var(--fg); font-weight: 600; }

  /*
   * The one place the page raises its voice. Still the same typeface — the
   * emphasis is size and tracking, not a second font or a gradient fill.
   */
  h1 {
    font-size: clamp(24px, 5.4vw, 40px);
    line-height: 1.25;
    letter-spacing: -0.035em;
    max-width: 20ch;
    margin-bottom: 40px;
  }

  .desc {
    color: var(--fg-muted);
    font-size: 14px;
    line-height: 1.8;
    max-width: 68ch;
    margin-bottom: 34px;
  }
  .desc b { color: var(--accent-soft); font-weight: 600; }

  .cta { display: grid; gap: 14px; max-width: 620px; }
  .cta-links { display: grid; gap: 10px; }

  @media (min-width: 600px) {
    .hero-inner { padding-block: 52px 72px; }
    .manline-mid { display: inline; }
    .cta-links { display: flex; gap: 12px; flex-wrap: wrap; }
    .name-line, .desc { font-size: 14.5px; }
  }

  @media (min-width: 880px) {
    .hero-inner { padding-block: 64px 88px; }
    h1 { margin-bottom: 48px; }
  }
</style>
