---
import Copyable from "./Copyable.astro";
---

<div class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <h1>
      Your AI assistant stops<br />
      guessing about <span class="hl">your codebase</span>.
    </h1>

    <p class="hero-lead">
      project-brain is a local-first MCP server that gives AI tools two kinds of memory of your
      code: <strong>semantic</strong> &mdash; a LanceDB vector index that finds code by meaning &mdash; and
      <strong>structural</strong> &mdash; a tree-sitter symbol graph that answers exactly who calls what,
      and what breaks if you change it.
    </p>

    <div class="hero-cta">
      <Copyable command="brew install jcsoftdev/tap/project-brain" />
      <div class="hero-links">
        <a class="btn btn-primary" href="#start">Quick start</a>
        <a class="btn" href="https://github.com/jcsoftdev/project-brain" rel="noopener">Read the docs</a>
      </div>
    </div>

    <div class="hero-stats">
      <div><b>0</b><span>services to run</span></div>
      <div><b>7</b><span>AI tools auto-registered</span></div>
      <div><b>20+</b><span>MCP tools exposed</span></div>
      <div><b>100%</b><span>on your machine</span></div>
    </div>
  </div>
</div>

<style>
  /*
   * Mobile-first hero. Base is a single column sized for a 320px viewport;
   * min-width queries add breathing room and the 4-up stat row.
   */
  .hero { position: relative; overflow: hidden; }

  .hero-glow {
    position: absolute;
    top: -220px;
    left: 50%;
    transform: translateX(-50%);
    width: min(900px, 160vw);
    height: 520px;
    background: radial-gradient(closest-side, var(--accent-glow), transparent 72%);
    pointer-events: none;
  }

  .hero-inner { position: relative; padding-block: 64px 56px; }

  h1 {
    font-size: clamp(30px, 8.4vw, 60px);
    letter-spacing: -0.03em;
    margin-bottom: 18px;
  }
  /* The forced break is a desktop line-length choice, not a phone one. */
  h1 br { display: none; }

  .hl {
    background: linear-gradient(96deg, var(--accent) 0%, var(--sky) 55%, var(--violet) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-lead {
    color: var(--fg-muted);
    font-size: clamp(15px, 4vw, 19px);
    max-width: 700px;
    margin-bottom: 28px;
  }
  .hero-lead strong { color: var(--fg); font-weight: 600; }

  .hero-cta { max-width: 640px; display: grid; gap: 14px; }

  /* Full-width stacked buttons are the reliable phone target; side by side from sm. */
  .hero-links { display: grid; gap: 10px; }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 16px;
    margin-top: 42px;
    padding-top: 26px;
    border-top: 1px solid var(--border-soft);
  }
  .hero-stats div { display: flex; flex-direction: column; gap: 2px; }
  .hero-stats b {
    font-family: var(--mono);
    font-size: clamp(22px, 6vw, 26px);
    font-weight: 600;
    color: var(--accent);
    letter-spacing: -0.02em;
  }
  .hero-stats span { font-size: 13px; color: var(--fg-dim); }

  @media (min-width: 600px) {
    .hero-inner { padding-block: 88px 78px; }
    h1 { margin-bottom: 22px; }
    .hero-lead { margin-bottom: 34px; }
    .hero-links { display: flex; gap: 12px; flex-wrap: wrap; }
    .hero-stats { gap: 16px; margin-top: 54px; padding-top: 30px; }
    .hero-stats span { font-size: 13.5px; }
  }

  @media (min-width: 880px) {
    .hero-glow { top: -320px; height: 620px; }
    .hero-inner { padding-block: 108px 96px; }
    h1 br { display: inline; }
    .hero-stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-top: 62px;
      padding-top: 32px;
    }
  }
</style>
