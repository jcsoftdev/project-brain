---
import { SECTIONS } from "../data/sections";
---

<header class="nav" data-nav>
  <div class="wrap nav-top">
    <a class="brand" href="/">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke="var(--accent)" stroke-width="1.6" />
        <circle cx="12" cy="12" r="2.4" fill="var(--accent)" />
        <path d="M12 3v3.6M12 17.4V21M3 12h3.6M17.4 12H21M5.6 5.6l2.6 2.6M15.8 15.8l2.6 2.6M18.4 5.6l-2.6 2.6M8.2 15.8l-2.6 2.6" stroke="var(--accent-dim)" stroke-width="1.3" stroke-linecap="round" />
      </svg>
      <span>project-brain</span>
    </a>

    <!-- Inline links, from 880px where all five fit on one line. -->
    <nav class="nav-links" aria-label="Sections">
      {SECTIONS.map((s) => <a href={s.href}>{s.label}</a>)}
    </nav>

    <div class="nav-actions">
      <a class="nav-gh" href="https://github.com/jcsoftdev/project-brain" rel="noopener">github</a>

      <!--
        Below 880px the five labels are ~480px of text — wider than the
        viewport. A disclosure keeps every label at full length and costs one
        tap, rather than truncating them or making the header a quarter of the
        screen tall.
      -->
      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="section-menu"
        data-nav-toggle
      >
        <span class="label-open">menu</span>
        <span class="label-close">close</span>
      </button>
    </div>
  </div>

  <nav id="section-menu" class="nav-menu" aria-label="Sections" hidden data-nav-menu>
    <div class="wrap nav-menu-inner">
      {SECTIONS.map((s) => <a href={s.href}>{s.label}</a>)}
    </div>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(6, 12, 14, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }

  .nav-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 54px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: var(--tap);
    color: var(--fg);
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .brand:hover { text-decoration: none; color: var(--accent); }
  .brand svg { flex-shrink: 0; }

  .nav-links { display: none; }

  .nav-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

  /* Every control is a bracketed word. No icon buttons — the page is characters. */
  .nav-gh,
  .nav-toggle {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 6px 10px;
    border: 1px solid var(--rule);
    border-radius: 0;
    background: transparent;
    color: var(--fg-dim);
    font-family: var(--mono);
    font-size: 12px;
    cursor: pointer;
  }
  .nav-gh::before, .nav-toggle::before { content: "["; margin-right: 6px; }
  .nav-gh::after, .nav-toggle::after { content: "]"; margin-left: 6px; }
  .nav-gh:hover, .nav-toggle:hover {
    color: var(--accent);
    border-color: var(--accent-dim);
    text-decoration: none;
  }
  .nav-toggle[aria-expanded="true"] { color: var(--accent); border-color: var(--accent-dim); }

  /* The label flips to the shell's own word for closing something. */
  .nav-toggle .label-open { display: inline; }
  .nav-toggle .label-close { display: none; }
  .nav-toggle[aria-expanded="true"] .label-open { display: none; }
  .nav-toggle[aria-expanded="true"] .label-close { display: inline; }

  .nav-menu:not([hidden]) {
    display: block;
    border-top: 1px solid var(--rule);
    background: var(--bg-soft);
  }
  .nav-menu-inner { display: grid; padding-block: 4px 10px; }
  .nav-menu a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    font-size: 14px;
    color: var(--fg-muted);
    border-bottom: 1px solid var(--rule);
  }
  .nav-menu a::before { content: "> "; color: var(--accent-quiet); margin-right: 8px; }
  .nav-menu a:last-child { border-bottom: none; }
  .nav-menu a:hover { color: var(--accent); text-decoration: none; }
  .nav-menu a:hover::before { color: var(--accent); }

  @media (min-width: 880px) {
    .nav-top { min-height: 58px; gap: 24px; }
    .brand { font-size: 14px; }
    .nav-links { display: flex; gap: 22px; font-size: 12.5px; }
    /* Inline nav links still need a real target height, not just a text box. */
    .nav-links a { display: inline-flex; align-items: center; min-height: 36px; color: var(--fg-dim); }
    .nav-links a:hover { color: var(--accent); text-decoration: none; }
    .nav-toggle { display: none; }
    .nav-menu:not([hidden]) { display: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-nav]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-nav-menu]");

  if (root && toggle && menu) {
    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      menu.hidden = !open;
    };

    const close = (returnFocus = false) => {
      if (!isOpen()) return;
      setOpen(false);
      if (returnFocus) toggle.focus();
    };

    toggle.addEventListener("click", () => setOpen(!isOpen()));

    // Choosing a destination should dismiss the menu covering it.
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) close();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close(true);
    });

    // A click anywhere else means the reader moved on.
    document.addEventListener("click", (event) => {
      if (!isOpen()) return;
      if (!root.contains(event.target as Node)) close();
    });

    /*
     * Crossing the breakpoint while open would leave aria-expanded="true" on a
     * button that is no longer rendered, and the panel hidden only by CSS.
     * Reset the state so the markup always describes what is on screen.
     */
    const desktop = window.matchMedia("(min-width: 880px)");
    const sync = () => desktop.matches && close();
    desktop.addEventListener("change", sync);
    sync();
  }
</script>
