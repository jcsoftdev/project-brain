---
const links = [
  { href: "#how", label: "How it works" },
  { href: "#start", label: "Quick start" },
  { href: "#tools", label: "Tools" },
  { href: "#recipes", label: "Recipes" },
  { href: "#install", label: "Install" },
];
---

<header class="nav">
  <div class="wrap nav-top">
    <a class="brand" href="/">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke="var(--accent)" stroke-width="1.6" />
        <circle cx="12" cy="12" r="2.4" fill="var(--accent)" />
        <path d="M12 3v3.6M12 17.4V21M3 12h3.6M17.4 12H21M5.6 5.6l2.6 2.6M15.8 15.8l2.6 2.6M18.4 5.6l-2.6 2.6M8.2 15.8l-2.6 2.6" stroke="var(--accent-dim)" stroke-width="1.3" stroke-linecap="round" />
      </svg>
      <span>project-brain</span>
    </a>

    <nav class="nav-links" aria-label="Sections">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <a class="nav-gh" href="https://github.com/jcsoftdev/project-brain" rel="noopener" aria-label="project-brain on GitHub">
      <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
      </svg>
      <span class="nav-gh-text">GitHub</span>
    </a>
  </div>

  <!--
    Phone navigation. Hiding the section links on mobile would leave a 8000px
    page with no way to jump; a scrollable strip keeps every destination
    reachable with a thumb. It is redundant from md up, where the links sit
    inline in the row above, so it is removed rather than duplicated.
  -->
  <nav class="nav-strip" aria-label="Sections">
    <div class="nav-strip-inner">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(7, 9, 13, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-soft);
  }

  .nav-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--tap);
    color: var(--fg);
    font-family: var(--mono);
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .brand:hover { text-decoration: none; }
  .brand svg { flex-shrink: 0; }

  /* Inline links are a desktop affordance — the strip below covers phones. */
  .nav-links { display: none; }

  .nav-gh {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 36px;
    min-width: 36px;
    flex-shrink: 0;
    font-size: 13.5px;
    color: var(--fg-muted);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 6px 10px;
  }
  .nav-gh:hover { color: var(--fg); border-color: var(--fg-dim); text-decoration: none; }
  /* The wordmark costs width a 320px viewport does not have; the icon reads alone. */
  .nav-gh-text { display: none; }

  .nav-strip {
    border-top: 1px solid var(--border-soft);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .nav-strip::-webkit-scrollbar { display: none; }
  .nav-strip-inner {
    display: flex;
    gap: 18px;
    width: max-content;
    padding-inline: max(var(--gutter), env(safe-area-inset-left));
  }
  .nav-strip a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: 13.5px;
    white-space: nowrap;
    color: var(--fg-muted);
  }
  .nav-strip a:hover { color: var(--fg); text-decoration: none; }

  @media (min-width: 600px) {
    .nav-gh-text { display: inline; }
    .nav-gh { padding: 6px 12px; }
  }

  @media (min-width: 880px) {
    .nav-top { min-height: 60px; gap: 24px; }
    .brand { font-size: 15px; gap: 9px; }
    .nav-links {
      display: flex;
      gap: 26px;
      font-size: 14px;
    }
    .nav-links a { color: var(--fg-muted); }
    .nav-links a:hover { color: var(--fg); text-decoration: none; }
    .nav-strip { display: none; }
  }
</style>
