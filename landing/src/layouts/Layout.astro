---
import "../styles/global.css";
import Mark from "../components/Mark.astro";

interface Props {
  title: string;
  description: string;
  /** 404 and any future utility page opts out of the index. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/*
 * PNG, not the SVG this used to point at. Facebook, LinkedIn and X do not
 * rasterise SVG for link previews — they render nothing at all, so every
 * shared link came out blank. The PNG is generated from the same og.svg by
 * screenshotting it at 1200x630 with the real self-hosted fonts loaded.
 */
const ogImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#17121d" />

    <!--
      Preloaded because both are used above the fold — the display face in the
      headline and the mono in the terminal window. Without this they are
      discovered only after the CSS parses, which is a visible swap on the
      largest text on the page.
    -->
    <link rel="preload" href="/fonts/outfit.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="project-brain" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="project-brain — your AI stops guessing about your codebase" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="project-brain — your AI stops guessing about your codebase" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "project-brain",
        applicationCategory: "DeveloperApplication",
        operatingSystem: "macOS, Linux, Windows",
        description,
        url: "https://brain.jcsoftdev.com",
        image: ogImage,
        license: "https://opensource.org/licenses/MIT",
        softwareHelp: "https://github.com/jcsoftdev/project-brain#readme",
        codeRepository: "https://github.com/jcsoftdev/project-brain",
        author: { "@type": "Person", name: "jcsoftdev", url: "https://github.com/jcsoftdev" },
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      })}
    />
  </head>
  <body>
    <Mark />
    <slot />
  </body>
</html>
