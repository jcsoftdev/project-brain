---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Copyable from "../components/Copyable.astro";
import DataTable from "../components/DataTable.astro";
import Footer from "../components/Footer.astro";

const hosts = [
  "Claude Code",
  "Codex",
  "Cursor",
  "Gemini CLI",
  "Windsurf",
  "Zed",
  "VS Code",
];

const steps = [
  {
    n: "01",
    cmd: "brew install jcsoftdev/tap/project-brain",
    title: "Install",
    body: "One self-contained binary. No Node, no Bun, nothing else at runtime — the runtime, the WASM grammars and the templates are all compiled in.",
  },
  {
    n: "02",
    cmd: "project-brain setup",
    title: "Register once per machine",
    body: "Detects every AI tool you have and registers the MCP server in each one. Also installs the brain-audit and brain-okf host skills.",
  },
  {
    n: "03",
    cmd: "project-brain init",
    title: "Index this project",
    body: "Detects the stack, writes a CLAUDE.md with MCP routing instructions, installs a git commit hook, scaffolds module docs, and runs the first index.",
  },
];

const semantic = [
  ["search_context", "Conceptual lookup. Ranked snippets, each with a chunk_id. The one to use when you cannot name the symbol."],
  ["expand_context", "Full body of a chunk_id — cheaper than the assistant re-reading the whole file."],
];

const lexical = [
  ["search_code", "Exact keyword search (BM25) over indexed code: identifiers, error strings, exact phrases. Works with no Ollama."],
];

const structural = [
  ["find_symbol", "project-brain find", "Exact definition by name — path, line range, kind, signature."],
  ["find_callers", "project-brain callers", "Every symbol that calls this one. Who depends on X."],
  ["find_callees", "project-brain callees", "Every symbol this one calls. What X depends on."],
  ["impact", "project-brain impact", "Blast radius — everything transitively affected if X changes."],
  ["trace_path", "project-brain trace", "Shortest call path from A to B, as an ordered chain."],
  ["repo_map", "project-brain map", "Token-budgeted overview ranked by PageRank over the call graph."],
];

const knowledge = [
  ["get_architecture", "Stack, modules, chunk and symbol counts in one call. Orientation before drilling in."],
  ["list_modules / get_module", "Browse the indexed structure by module and pull a module whole."],
  ["add_knowledge", "Persist a note or decision into the brain so it survives the session."],
  ["manage_adr", "Create or list Architecture Decision Records. Append-only — supersede, never edit."],
  ["sync_project", "Re-index changed files now, incrementally, hash-gated."],
  ["check_health", "Embedding service and index status — run it when results look empty or stale."],
];

const recipes = [
  ["Refactor without fear", "What breaks if I change parseConfig?", "impact"],
  ["Understand unfamiliar code", "How does authentication work here?", "search_context"],
  ["Find a definition fast", "Where is GraphStore defined?", "find_symbol"],
  ["Trace a dependency", "Who calls chargeCard?", "find_callers"],
  ["Onboard to a module", "Summarize the store module", "get_module"],
  ["Persist a decision", "Remember that we use RRF for hybrid search", "add_knowledge"],
];

const channels = [
  ["Homebrew", "brew install jcsoftdev/tap/project-brain", "macOS (Apple Silicon), Linux", "brew upgrade project-brain"],
  ["curl", "curl -fsSL .../scripts/install.sh | sh", "macOS (Apple Silicon), Linux x64/arm64", "re-run the installer"],
  ["Registry", "bun install -g project-brain", "all, including Intel macOS and Windows", "project-brain update"],
  ["Scoop", "scoop install project-brain", "Windows — bucket not published yet", "scoop update project-brain"],
];
---

<Layout
  title="project-brain — semantic and structural memory of your codebase, for AI tools"
  description="Local-first MCP server that gives AI assistants two kinds of memory of your code: a LanceDB semantic index and a tree-sitter symbol graph. Runs entirely on your machine. MIT."
>
  <Nav />
  <Hero />

  <div class="hosts">
    <div class="wrap hosts-inner">
      <span class="hosts-label">Registers itself in</span>
      <ul>{hosts.map((h) => <li>{h}</li>)}</ul>
    </div>
  </div>

  <!-- ── How it works ───────────────────────────────────────────── -->
  <section id="how">
    <div class="wrap">
      <p class="eyebrow">The two brains</p>
      <h2 class="section-title">Grep does not know what your code means.<br />Embeddings do not know what it calls.</h2>
      <p class="section-lead">
        An AI assistant left alone with your repository does one of two things: it greps for a string
        and misses everything phrased differently, or it reads whole files until the context window
        gives out. Neither answers <em>&ldquo;what breaks if I change this&rdquo;</em>. project-brain builds both
        indexes, locally, and tells the assistant which one to reach for.
      </p>

      <div class="grid grid-2 brains">
        <article class="card brain">
          <span class="tag" style="color: var(--accent); border-color: var(--accent-dim);">Semantic</span>
          <h3>LanceDB vector index</h3>
          <p class="dim">
            Your files are chunked and embedded with a local Ollama model into a LanceDB store.
            Retrieval is by <strong>meaning</strong>, so &ldquo;how does auth work&rdquo; finds the middleware, the
            token parser and the session store — none of which contain the word you typed.
          </p>
          <ul class="ticks">
            <li>Hybrid BM25 + vector retrieval, RRF-reranked</li>
            <li>Degrades to a lexical floor when Ollama is off, flagged rather than silent</li>
            <li>Honors .gitignore; skips generated and minified files</li>
          </ul>
        </article>

        <article class="card brain">
          <span class="tag" style="color: var(--violet); border-color: var(--violet);">Structural</span>
          <h3>tree-sitter symbol graph</h3>
          <p class="dim">
            A WASM tree-sitter parser extracts every symbol and call edge into a local SQLite graph.
            Retrieval is <strong>exact</strong>: definitions, callers, callees, blast radius, shortest call
            path. No embedding model involved, no approximation, sub-millisecond reads.
          </p>
          <ul class="ticks">
            <li>Works fully offline — no Ollama, no network</li>
            <li>Every graph tool is also a native CLI command</li>
            <li>PageRank ranking for &ldquo;where do I start reading&rdquo;</li>
          </ul>
        </article>
      </div>

      <div class="card auto">
        <h3>And it stays fresh on its own</h3>
        <div class="grid grid-3 auto-grid">
          <div>
            <code>git commit</code>
            <p class="dim">The installed hook runs an incremental sync. The index never drifts behind the branch.</p>
          </div>
          <div>
            <code>file save</code>
            <p class="dim">While the server runs, the watcher re-indexes the changed file. No manual step.</p>
          </div>
          <div>
            <code>assistant connects</code>
            <p class="dim">The MCP server starts on stdio and injects routing instructions, so the model picks the right tool.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Quick start ────────────────────────────────────────────── -->
  <section id="start">
    <div class="wrap">
      <p class="eyebrow">Quick start</p>
      <h2 class="section-title">Three commands, about two minutes</h2>
      <p class="section-lead">
        Nothing to host, nothing to sign up for, no key to paste. Everything below runs on your
        machine and stays there.
      </p>

      <ol class="steps">
        {steps.map((s) => (
          <li class="card step">
            <span class="step-n mono">{s.n}</span>
            <div class="step-body">
              <h3>{s.title}</h3>
              <p class="dim">{s.body}</p>
              <Copyable command={s.cmd} />
            </div>
          </li>
        ))}
      </ol>

      <div class="card verify">
        <h3>Then confirm it worked</h3>
        <p class="dim">
          <code>health</code> is the command that tells you why, when semantic results come back empty:
          it reports the embedding service, the index counts and how stale they are.
        </p>
        <Copyable command="project-brain health" />
      </div>
    </div>
  </section>

  <!-- ── Tools ──────────────────────────────────────────────────── -->
  <section id="tools">
    <div class="wrap">
      <p class="eyebrow">MCP tools</p>
      <h2 class="section-title">What your assistant gets</h2>
      <p class="section-lead">
        The server ships routing instructions alongside the tools, so the model reaches for the exact
        one instead of defaulting to a semantic search for a structural question.
      </p>

      <div class="tool-block">
        <h3 class="tool-h"><span class="dot" style="background: var(--accent)"></span>Semantic — meaning-based</h3>
        <DataTable columns={["Tool", "What it does"]} rows={semantic} code={[0]} />
      </div>

      <div class="tool-block">
        <h3 class="tool-h"><span class="dot" style="background: var(--amber)"></span>Lexical — keyword, no embeddings needed</h3>
        <DataTable columns={["Tool", "What it does"]} rows={lexical} code={[0]} />
      </div>

      <div class="tool-block">
        <h3 class="tool-h"><span class="dot" style="background: var(--violet)"></span>Structural — AST graph, exact</h3>
        <DataTable columns={["Tool", "CLI", "What it does"]} rows={structural} code={[0, 1]} />
      </div>

      <div class="tool-block">
        <h3 class="tool-h"><span class="dot" style="background: var(--sky)"></span>Modules &amp; knowledge</h3>
        <DataTable columns={["Tool", "What it does"]} rows={knowledge} code={[0]} />
      </div>
    </div>
  </section>

  <!-- ── Recipes ────────────────────────────────────────────────── -->
  <section id="recipes">
    <div class="wrap">
      <p class="eyebrow">What to ask it</p>
      <h2 class="section-title">You ask in English. It picks the tool.</h2>
      <p class="section-lead">
        These prompts steer it well. You never name a tool — the routing instructions do that.
      </p>

      <DataTable
        columns={["Goal", "Ask your assistant", "Tool it reaches for"]}
        rows={recipes.map(([goal, prompt, tool]) => [goal, `\u201c${prompt}\u201d`, tool])}
        code={[2]}
        italic={[1]}
      />

      <div class="grid grid-2 split">
        <article class="card">
          <span class="tag">Offline</span>
          <h3>No Ollama? Most of it still works.</h3>
          <p class="dim">
            Ollama powers semantic search only. The whole structural graph and the keyword index read
            local files with no model at all — and <code>search_context</code> itself falls back to a
            code-aware BM25 floor, marked <code>degraded</code> rather than failing quietly.
          </p>
          <Copyable command="project-brain init --no-embed" />
        </article>

        <article class="card">
          <span class="tag">Host skills</span>
          <h3>Two skills with no CLI equivalent</h3>
          <p class="dim">
            <code>brain-audit</code> runs a whole-project audit — dead code, orphan UI, broken flows,
            findings ranked by severity — answering &ldquo;is this export dead?&rdquo; with
            <code>find_callers</code> instead of a guess from a grep. <code>brain-okf</code> writes a
            knowledge concept and verifies its anchor first. Both are offered, never scheduled.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ── OKF ────────────────────────────────────────────────────── -->
  <section id="okf">
    <div class="wrap">
      <div class="okf">
        <div>
          <p class="eyebrow">Knowledge bundles</p>
          <h2 class="section-title">The index knows <em>what</em>.<br />An OKF bundle holds <em>why</em>.</h2>
          <p class="section-lead">
            No parser can recover the reasoning behind a decision, because it was never in the AST.
            An Open Knowledge Format v0.2 bundle — committed Markdown with YAML frontmatter — holds
            that half, anchored to real symbols. And <code>okf audit</code> keeps the two honest about
            each other: it fails CI on a broken anchor or a concept whose code moved on without it.
          </p>
          <Copyable command="project-brain okf init" />
        </div>

        <div class="card okf-findings">
          <h3 class="mono">okf audit reports</h3>
          <dl>
            <dt>Broken anchor</dt>
            <dd>The cited file or symbol is gone — the explanation points at nothing. <b>Exits 1.</b></dd>
            <dt>Stale concept</dt>
            <dd>The cited code changed after the knowledge was last confirmed, by git commit date. <b>Exits 1.</b></dd>
            <dt>Coverage gap</dt>
            <dd>Highest-PageRank symbols no concept explains — a backlog in priority order.</dd>
            <dt>Link suggestion</dt>
            <dd>Two concepts whose code calls across them, but whose prose never does.</dd>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Install ────────────────────────────────────────────────── -->
  <section id="install">
    <div class="wrap">
      <p class="eyebrow">Install</p>
      <h2 class="section-title">Pick a channel</h2>
      <p class="section-lead">
        Every channel ships the same artifact: a compiled binary with the runtime, WASM grammars and
        templates embedded. <code>project-brain update</code> reads the binary&rsquo;s own path to work out
        which channel installed it, and prints the matching command rather than guessing.
      </p>

      <DataTable
        columns={["Channel", "Command", "Platforms", "Upgrade"]}
        rows={channels}
        code={[1, 3]}
      />

      <p class="note dim">
        <b>Intel macOS:</b> no prebuilt binary. Homebrew and curl both refuse rather than hand you an
        arm64 binary — use a registry install there.
      </p>
    </div>
  </section>

  <!-- ── CTA ────────────────────────────────────────────────────── -->
  <section class="cta-section">
    <div class="wrap cta">
      <h2 class="section-title">Give it a repository and ask it something hard.</h2>
      <p class="section-lead" style="margin-inline: auto;">
        Free, MIT, and it never sends your code anywhere.
      </p>
      <Copyable command="brew install jcsoftdev/tap/project-brain" />
      <div class="cta-links">
        <a class="btn btn-primary" href="https://github.com/jcsoftdev/project-brain" rel="noopener">Star on GitHub</a>
        <a class="btn" href="https://www.npmjs.com/package/project-brain" rel="noopener">View on npm</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ── hosts strip ──────────────────────────────────────────────
     On a phone this scrolls horizontally rather than wrapping into a
     four-line block that pushes the fold down before anything is read. */
  .hosts {
    border-top: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
    background: var(--bg-soft);
  }
  .hosts-inner { padding-block: 16px; }
  .hosts-label {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
    margin-bottom: 10px;
  }
  .hosts ul {
    display: flex;
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .hosts ul::-webkit-scrollbar { display: none; }
  .hosts li {
    font-size: 14px;
    color: var(--fg-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  /* ── brains ─────────────────────────────────────────────────── */
  .brains { margin-bottom: 14px; }
  .brain h3 { font-size: 18px; margin: 12px 0 9px; }
  .brain p { font-size: 14.5px; }
  .brain strong { color: var(--fg); }
  .ticks { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 8px; }
  .ticks li { position: relative; padding-left: 20px; font-size: 13.5px; color: var(--fg-muted); }
  .ticks li::before { content: "\2192"; position: absolute; left: 0; color: var(--accent); font-family: var(--mono); }

  .auto h3 { font-size: 17px; margin-bottom: 16px; }
  .auto-grid code { display: inline-block; margin-bottom: 7px; }
  .auto-grid p { font-size: 13.5px; }

  /* ── steps ──────────────────────────────────────────────────── */
  .steps { list-style: none; margin: 0 0 14px; padding: 0; display: grid; gap: 14px; }
  /* The number sits above the text on a phone so the body keeps full width. */
  .step { display: grid; gap: 10px; }
  .step-n { font-size: 12px; color: var(--fg-dim); letter-spacing: 0.08em; }
  .step-body { min-width: 0; display: grid; gap: 10px; }
  .step-body h3 { font-size: 17px; }
  .step-body p { font-size: 14px; margin-bottom: 2px; }

  .verify h3 { font-size: 17px; margin-bottom: 9px; }
  .verify p { font-size: 14px; margin-bottom: 14px; }

  /* ── tools ──────────────────────────────────────────────────── */
  .tool-block { margin-bottom: 26px; }
  .tool-block .card { padding: 0; }
  .tool-h {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 14.5px;
    margin-bottom: 12px;
    color: var(--fg-muted);
    font-weight: 600;
  }
  .dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; flex-shrink: 0; }

  .split { margin-top: 28px; }
  .split h3 { font-size: 17px; margin: 11px 0 9px; }
  .split p { font-size: 14px; margin-bottom: 14px; }

  /* ── okf ────────────────────────────────────────────────────── */
  .okf { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; align-items: start; }
  .okf .section-lead { margin-bottom: 22px; }
  .okf-findings h3 {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
    font-weight: 500;
    margin: 0 0 16px;
  }
  .okf-findings dl { margin: 0; display: grid; gap: 15px; }
  .okf-findings dt { font-weight: 600; font-size: 14px; color: var(--fg); }
  .okf-findings dd { margin: 3px 0 0; font-size: 13.5px; color: var(--fg-muted); }
  .okf-findings b { color: var(--amber); font-weight: 500; font-family: var(--mono); font-size: 12px; }

  .note { font-size: 13.5px; margin-top: 16px; }

  /* ── cta ────────────────────────────────────────────────────── */
  .cta-section { background: var(--bg-soft); }
  .cta { text-align: center; max-width: 620px; }
  /* The command is code — centring it ragged-wraps the path across two lines. */
  .cta :global(.copyable) { text-align: left; }
  .cta-links { display: grid; gap: 10px; margin-top: 18px; }

  /* ── sm: 600px+ ─────────────────────────────────────────────── */
  @media (min-width: 600px) {
    .hosts-inner { display: flex; align-items: center; gap: 24px; padding-block: 20px; }
    .hosts-label { margin-bottom: 0; white-space: nowrap; }
    .hosts ul { flex-wrap: wrap; overflow-x: visible; gap: 22px; }
    .hosts-label { font-size: 11.5px; }
    .hosts li { font-size: 14.5px; }

    .brains { margin-bottom: 16px; }
    .brain h3 { font-size: 20px; margin: 14px 0 10px; }
    .brain p { font-size: 15px; }
    .ticks { margin-top: 18px; gap: 9px; }
    .ticks li { padding-left: 22px; font-size: 14px; }

    .auto h3 { font-size: 18px; margin-bottom: 20px; }
    .auto-grid p { font-size: 14px; }

    .steps { gap: 16px; margin-bottom: 16px; }
    .step { grid-template-columns: auto minmax(0, 1fr); gap: 22px; align-items: start; }
    .step-n { font-size: 13px; padding-top: 4px; }
    .step-body h3 { font-size: 18px; }
    .step-body p { font-size: 14.5px; margin-bottom: 4px; }

    .verify h3 { font-size: 18px; margin-bottom: 10px; }
    .verify p { font-size: 14.5px; margin-bottom: 16px; }

    .tool-block { margin-bottom: 34px; }
    .tool-h { font-size: 15px; margin-bottom: 14px; gap: 10px; }

    .split { margin-top: 36px; }
    .split h3 { font-size: 18px; margin: 12px 0 10px; }
    .split p { font-size: 14.5px; margin-bottom: 16px; }

    .okf-findings h3 { font-size: 11.5px; margin-bottom: 18px; }
    .okf-findings dl { gap: 16px; }
    .okf-findings dt { font-size: 14.5px; }
    .okf-findings dd { font-size: 14px; }
    .okf-findings b { font-size: 12.5px; }

    .note { font-size: 14px; margin-top: 18px; }
    .cta-links { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 20px; }
  }

  /* ── md: 880px+ ─────────────────────────────────────────────── */
  @media (min-width: 880px) {
    .okf { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 44px; }
    .okf .section-lead { margin-bottom: 26px; }
  }
</style>
